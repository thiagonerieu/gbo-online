# Contrôleur frontal : toute URL qui n'est pas un fichier ou un dossier existant
# est envoyée à index.php (routeur MVC).
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
